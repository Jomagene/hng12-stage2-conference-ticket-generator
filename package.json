{
  "name": "ticz-conference-tickets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "vercel-build": "npm run db:migrate && next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.5.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
