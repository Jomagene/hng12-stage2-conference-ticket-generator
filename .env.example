# Copy to .env.local and adjust. Everything is optional for local development.

# Postgres connection string (Neon, Supabase, RDS…). Required in production.
# Leave unset locally to use the embedded database in .data/ (seeded with demo events).
DATABASE_URL=

# Public URL of the deployment (Open Graph links, demo manage links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary account and *unsigned* upload preset for attendee photos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ds0sysk6d
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=profile_upload
