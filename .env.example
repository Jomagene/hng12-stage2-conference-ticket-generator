# Copy to .env.local. Everything is optional for local development.

# Postgres. Leave unset locally to use the embedded database in .data/ (seeded with demo events).
# Supabase: DATABASE_URL = transaction pooler (port 6543), DATABASE_DIRECT_URL = session pooler (port 5432).
DATABASE_URL=
# Used by migrations (npm run db:migrate). Falls back to DATABASE_URL.
DATABASE_DIRECT_URL=

# Public settings have defaults in .env; override them here if needed.
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
